           RowBox[{"NumberForm", "[", 
            RowBox[{"t", ",", 
             RowBox[{"{", 
              RowBox[{"4", ",", "1"}], "}"}]}], "]"}]}], "}"}], "]"}]}]}], 
      "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"t", ",", "tmin", ",", "tmax"}], "}"}]}], "]"}], 
   "\n"}]}]], "Input",
