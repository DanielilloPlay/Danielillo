Cell[CellGroupData[{
Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
   "===", "===", "===", "===", "===", "===", "===", "===", "===", "===", "===",
     "===", "===", "===", "=="}], "*)"}], 
  RowBox[{"(*", "LIMPIEZA", "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"ClearAll", "[", "\"\<Global`*\>\"", "]"}], "\[IndentingNewLine]", 
   "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
    "===", "===", "===", "===", "===", "===", "===", "===", "===", "===", "===",
      "===", "===", "===", "=="}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{"(*", "PAR\[CapitalAAcute]METROS", "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"mass", "=", "1"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"\[Theta]", "=", 
     RowBox[{"Pi", "/", "2"}]}], ";"}], "   ", 
   RowBox[{"(*", 
    RowBox[{"\[AAcute]ngulo", " ", "fijo"}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"csc2", "=", 
     RowBox[{
      RowBox[{"Csc", "[", "\[Theta]", "]"}], "^", "2"}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
    "===", "===", "===", "===", "===", "===", "===", "===", "===", "===", "===",
      "===", "===", "===", "=="}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"FUNCI\[CapitalOAcute]N", " ", "DESCONOCIDA"}], "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{"Clear", "[", 
    RowBox[{"Hm", ",", "t", ",", "r"}], "]"}], "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
    "===", "===", "===", "===", "===", "===", "===", "===", "===", "===", "===",
      "===", "===", "===", "=="}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"ECUACI\[CapitalOAcute]N", " ", "DIFERENCIAL"}], "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"eq", "=", 
     RowBox[{
      RowBox[{
       RowBox[{"2", " ", 
        RowBox[{"Hm", "[", 
         RowBox[{"t", ",", "r"}], "]"}], " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"2", " ", "mass"}], "-", "r"}], ")"}], " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"5", " ", "mass"}], "-", "r", "+", 
          RowBox[{"2", " ", "csc2", " ", "r"}]}], ")"}]}], "+", 
       RowBox[{"r", " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{
           RowBox[{"-", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{"7", " ", "mass"}], "-", 
              RowBox[{"4", " ", "r"}]}], ")"}]}], " ", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{"2", " ", "mass"}], "-", "r"}], ")"}], " ", 
           RowBox[{"D", "[", 
            RowBox[{
             RowBox[{"Hm", "[", 
              RowBox[{"t", ",", "r"}], "]"}], ",", "r"}], "]"}]}], "+", 
          RowBox[{
           RowBox[{
            RowBox[{"(", 
             RowBox[{
              RowBox[{"2", " ", "mass"}], "-", "r"}], ")"}], "^", "2"}], " ", 
           RowBox[{"D", "[", 
            RowBox[{
             RowBox[{"Hm", "[", 
              RowBox[{"t", ",", "r"}], "]"}], ",", 
             RowBox[{"{", 
              RowBox[{"r", ",", "2"}], "}"}]}], "]"}]}], "+", 
          RowBox[{"6", " ", "mass", " ", 
           RowBox[{"D", "[", 
            RowBox[{
             RowBox[{"Hm", "[", 
              RowBox[{"t", ",", "r"}], "]"}], ",", "t"}], "]"}]}], "-", 
          RowBox[{
           RowBox[{"r", "^", "2"}], " ", 
           RowBox[{"D", "[", 
            RowBox[{
             RowBox[{"Hm", "[", 
              RowBox[{"t", ",", "r"}], "]"}], ",", 
             RowBox[{"{", 
              RowBox[{"t", ",", "2"}], "}"}]}], "]"}]}]}], ")"}]}]}], "==", 
      "0"}]}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{
    "===", "===", "===", "===", "===", "===", "===", "===", "===", "===", "===",
      "===", "===", "===", "=="}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{"(*", "DOMINIO", "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"tmin", "=", "0"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"tmax", "=", "50"}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"rmin", "=", 
     RowBox[{
      RowBox[{"2", " ", "mass"}], "+", "10"}]}], ";"}], "   ", 
   RowBox[{"(*", 
    RowBox[{"lejos", " ", "del", " ", "horizonte"}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"rmax", "=", "75"}], ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
    "===", "===", "===", "===", "===", "===", "===", "===", "===", "===", "===",
      "===", "===", "===", "=="}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"CONDICIONES", " ", "INICIALES", " ", 
     RowBox[{"(", 
      RowBox[{"pulso", " ", "gaussiano"}], ")"}]}], "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"r0", "=", "10"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"\[Sigma]", "=", "6"}], ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"ic1", "=", 
     RowBox[{
      RowBox[{"Hm", "[", 
       RowBox[{"0", ",", "r"}], "]"}], "==", 
      RowBox[{
       RowBox[{"r", "^", 
        RowBox[{"-", "4"}]}], 
       RowBox[{"Exp", "[", 
        RowBox[{
         RowBox[{"-", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{"r", "-", "r0"}], ")"}], "^", "2"}]}], "/", "\[Sigma]"}], 
        "]"}]}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"ic2", "=", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{"D", "[", 
         RowBox[{
          RowBox[{"Hm", "[", 
           RowBox[{"t", ",", "r"}], "]"}], ",", "t"}], "]"}], "/.", " ", 
        RowBox[{"t", "->", "0"}]}], ")"}], "==", "0"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{
    "===", "===", "===", "===", "===", "===", "===", "===", "===", "===", "===",
      "===", "===", "===", "=="}], "*)"}], "\n", 
   RowBox[{"(*", 
    RowBox[{"CONDICIONES", " ", "DE", " ", "BORDE"}], "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"bc1", "=", 
     RowBox[{
      RowBox[{"Hm", "[", 
       RowBox[{"t", ",", "rmin"}], "]"}], "==", "0"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"bc2", "=", 
     RowBox[{
      RowBox[{"Hm", "[", 
       RowBox[{"t", ",", "rmax"}], "]"}], "==", "0"}]}], ";"}], "\n", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{
    "===", "===", "===", "===", "===", "===", "===", "===", "===", "===", "===",
      "===", "===", "===", "=="}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"RESOLUCI\[CapitalOAcute]N", " ", "NUM\[CapitalEAcute]RICA"}], 
    "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"sol", "=", 
     RowBox[{"NDSolve", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"eq", ",", "ic1", ",", "ic2", ",", "bc1", ",", "bc2"}], "}"}],
        ",", "Hm", ",", 
       RowBox[{"{", 
        RowBox[{"t", ",", "tmin", ",", "tmax"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"r", ",", "rmin", ",", "rmax"}], "}"}], ",", 
       RowBox[{"Method", "->", 
        RowBox[{"{", 
         RowBox[{"\"\<MethodOfLines\>\"", ",", 
          RowBox[{"\"\<SpatialDiscretization\>\"", "->", 
           RowBox[{"{", 
            RowBox[{"\"\<TensorProductGrid\>\"", ",", 
             RowBox[{"\"\<MinPoints\>\"", "->", "300"}], ",", 
             RowBox[{"\"\<MaxPoints\>\"", "->", "600"}]}], "}"}]}]}], "}"}]}],
        ",", 
       RowBox[{"MaxStepFraction", "->", 
        RowBox[{"1", "/", "100"}]}]}], "]"}]}], ";"}], "\n", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{
    "===", "===", "===", "===", "===", "===", "===", "===", "===", "===", "===",
      "===", "===", "===", "=="}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{"(*", "ANIMACI\[CapitalOAcute]N", "*)"}], "\[IndentingNewLine]", 
   RowBox[{"Animate", "[", 
    RowBox[{
     RowBox[{"Plot", "[", 
      RowBox[{
       RowBox[{"Evaluate", "[", 
        RowBox[{
         RowBox[{"Hm", "[", 
          RowBox[{"t", ",", "r"}], "]"}], "/.", " ", "sol"}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"r", ",", "rmin", ",", "rmax"}], "}"}], ",", 
       RowBox[{"PlotRange", "->", "All"}], ",", 
       RowBox[{"AxesLabel", "->", 
        RowBox[{"{", 
         RowBox[{"\"\<r\>\"", ",", "\"\<h\:208a\>\""}], "}"}]}], ",", 
       RowBox[{"PlotLabel", "->", 
