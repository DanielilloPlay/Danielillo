Cell[BoxData[
 RowBox[{"\[IndentingNewLine]", "\n", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"1.", " ", "Espacio"}], "-", 
    RowBox[{"tiempo", " ", "M4"}]}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"DefManifold", "[", 
    RowBox[{"M4", ",", "4", ",", 
     RowBox[{"{", 
      RowBox[{"a", ",", "b", ",", "c", ",", "d", ",", "e", ",", "f"}], 
      "}"}]}], "]"}], "\n", 
   RowBox[{"DefMetric", "[", 
    RowBox[{
     RowBox[{"-", "1"}], ",", 
     RowBox[{"g", "[", 
      RowBox[{
       RowBox[{"-", "a"}], ",", 
       RowBox[{"-", "b"}]}], "]"}], ",", "CD", ",", 
     RowBox[{"{", 
      RowBox[{"\"\<;\>\"", ",", "\"\<\[Del]\>\""}], "}"}]}], "]"}], "\n", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"2.", " ", "EL", " ", 
     RowBox[{"TRUCO", ":", 
      RowBox[{
      "Definimos", " ", "el", " ", "espacio", " ", "interno", " ", "SU", 
       RowBox[{"(", "2", ")"}], " ", "como", " ", "otra", " ", "variedad", 
       " ", "pura"}]}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{"DefManifold", "[", 
    RowBox[{"SU2", ",", "3", ",", 
     RowBox[{"{", 
      RowBox[{"i", ",", "j", ",", "k", ",", "l", ",", "m"}], "}"}]}], "]"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"DefSubmanifold", "[", 
     RowBox[{"SU2", ",", "M4"}], "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{
     "Como", " ", "SU2", " ", "ahora", " ", "es", " ", "una", " ", "variedad",
       " ", "completa"}], ",", 
     RowBox[{
     "S\[CapitalIAcute]", " ", "soporta", " ", "su", " ", "propia", " ", 
      "derivada", " ", 
      RowBox[{"covariante", ".", "Al"}], " ", "definir", " ", "su", " ", 
      "m\[EAcute]trica"}], ",", 
     RowBox[{
      RowBox[{
      "xAct", " ", "crea", " ", "AUTOM\[CapitalAAcute]TICAMENTE", " ", "el", 
       " ", "Levi"}], "-", 
      RowBox[{"Civita", " ", "llamado", " ", "\"\<Volh\>\""}]}]}], "*)"}], 
   "\n", 
   RowBox[{"DefMetric", "[", 
    RowBox[{"1", ",", 
     RowBox[{"h", "[", 
      RowBox[{
       RowBox[{"-", "i"}], ",", 
       RowBox[{"-", "j"}]}], "]"}], ",", "Ch"}], "]"}], "\[IndentingNewLine]",
    "\n", 
   RowBox[{"(*", 
    RowBox[{
    "3.", " ", "Definimos", " ", "los", " ", "campos", " ", "indicando", " ", 
     "que", " ", "viven", " ", "en", " ", "AMBAS", " ", "variedades"}], 
    "*)"}], "\[IndentingNewLine]", 
   RowBox[{"DefTensor", "[", 
    RowBox[{
     RowBox[{"A", "[", 
      RowBox[{
       RowBox[{"-", "i"}], ",", 
       RowBox[{"-", "a"}]}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"SU2", ",", "M4"}], "}"}]}], "]"}], "\n", 
   RowBox[{"DefTensor", "[", 
    RowBox[{
     RowBox[{"alpha", "[", 
      RowBox[{
       RowBox[{"-", "i"}], ",", 
       RowBox[{"-", "a"}], ",", 
       RowBox[{"-", "b"}]}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"SU2", ",", "M4"}], "}"}], ",", 
     RowBox[{"Antisymmetric", "[", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"-", "a"}], ",", 
        RowBox[{"-", "b"}]}], "}"}], "]"}], ",", 
     RowBox[{"PrintAs", "->", "\"\<\[Alpha]\>\""}]}], "]"}], 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "Par\[AAcute]metros", " ", "para", " ", "las", " ", "transformaciones", 
     " ", "infinitesimales"}], "*)"}], "\n", 
   RowBox[{"DefTensor", "[", 
    RowBox[{
     RowBox[{"xi", "[", "a", "]"}], ",", "M4", ",", 
     RowBox[{"PrintAs", "->", "\"\<\[Xi]\>\""}]}], "]"}], "       ", 
   RowBox[{"(*", 
    RowBox[{"Vector", " ", "de", " ", "difeomorfismo"}], "*)"}], "\n", 
   RowBox[{"DefTensor", "[", 
    RowBox[{
     RowBox[{"omega", "[", 
      RowBox[{"-", "i"}], "]"}], ",", "M4", ",", 
     RowBox[{"PrintAs", "->", "\"\<\[Omega]\>\""}]}], "]"}], " ", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"A", ")"}], " ", 
     RowBox[{"DIFEOMORFISMOS", ":", 
      RowBox[{
      "Derivada", " ", "de", " ", "Lie", " ", "del", " ", "campo", " ", 
       "alpha"}]}]}], "*)"}], 
   RowBox[{"Print", "[", "\"\<Derivada de Lie de alpha:\>\"", "]"}], "\n", 
   RowBox[{"LieAlpha", "=", 
    RowBox[{
     RowBox[{"LieD", "[", 
      RowBox[{"xi", "[", "c", "]"}], "]"}], "[", 
     RowBox[{"alpha", "[", 
      RowBox[{
       RowBox[{"-", "i"}], ",", 
       RowBox[{"-", "a"}], ",", 
       RowBox[{"-", "b"}]}], "]"}], "]"}]}], "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{
    "Para", " ", "ver", " ", "c\[OAcute]mo", " ", "se", " ", "expande", " ", 
     "usando", " ", "derivadas", " ", "parciales", " ", "o", " ", 
     RowBox[{"covariantes", ":"}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{"Print", "[", "\"\<Derivada de Lie expandida:\>\"", "]"}], "\n", 
   RowBox[{
    RowBox[{"LieDToCovD", "[", "LieAlpha", "]"}], "//", "ToCanonical"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"B", ")"}], " ", "TRANSFORMACI\[CapitalOAcute]N", " ", "GAUGE", 
     " ", "LOCAL", " ", "SU", 
     RowBox[{"(", "2", ")"}], " ", "de", " ", "alpha"}], "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"delta_omega", " ", 
      RowBox[{"alpha", "^", "i_ab"}]}], "=", 
     RowBox[{
      RowBox[{"eps", "^", "i_"}], 
      RowBox[{"{", "jk", "}"}], " ", 
      RowBox[{"omega", "^", "j"}], " ", 
      RowBox[{"alpha", "^", "k_ab"}]}]}], "*)"}], "\n", 
   RowBox[{
   "Print", "[", "\"\<Transformaci\[OAcute]n Gauge de alpha:\>\"", "]"}], 
   "\n", 
   RowBox[{"GaugeAlpha", "=", 
    RowBox[{
     RowBox[{
      RowBox[{"epsilonh", "[", 
       RowBox[{"i", ",", 
        RowBox[{"-", "j"}], ",", 
        RowBox[{"-", "k"}]}], "]"}], " ", 
      RowBox[{"omega", "[", "j", "]"}], " ", 
      RowBox[{"alpha", "[", 
       RowBox[{"k", ",", 
        RowBox[{"-", "a"}], ",", 
        RowBox[{"-", "b"}]}], "]"}]}], "//", "ToCanonical"}]}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"C", ")"}], " ", "CURVATURA", " ", "GAUGE", " ", 
     RowBox[{"F", "^", "i_ab"}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Definimos", " ", "la", " ", "regla", " ", "para", " ", "F", 
     RowBox[{"(", "A", ")"}], " ", "en", " ", "t\[EAcute]rminos", " ", "de", 
     " ", "la", " ", "conexi\[OAcute]n"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{"Print", "[", "\"\<Tensor de Curvatura F:\>\"", "]"}], "\n", 
   RowBox[{"CurvaturaF", "=", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"CD", "[", 
        RowBox[{"-", "a"}], "]"}], "[", 
       RowBox[{"A", "[", 
        RowBox[{
         RowBox[{"-", "i"}], ",", 
         RowBox[{"-", "b"}]}], "]"}], "]"}], "-", 
      RowBox[{
       RowBox[{"CD", "[", 
        RowBox[{"-", "b"}], "]"}], "[", 
       RowBox[{"A", "[", 
        RowBox[{
         RowBox[{"-", "i"}], ",", 
         RowBox[{"-", "a"}]}], "]"}], "]"}], "+", 
      RowBox[{"I", " ", 
       RowBox[{"epsilonh", "[", 
        RowBox[{
         RowBox[{"-", "i"}], ",", 
         RowBox[{"-", "j"}], ",", 
         RowBox[{"-", "k"}]}], "]"}], " ", 
       RowBox[{"A", "[", 
        RowBox[{"j", ",", 
         RowBox[{"-", "a"}]}], "]"}], " ", 
       RowBox[{"A", "[", 
        RowBox[{"k", ",", 
         RowBox[{"-", "b"}]}], "]"}]}]}], "//", "ToCanonical"}]}], 
   "\[IndentingNewLine]"}]}]], "Input",
